class Solution {
public:
    int findNumbers(vector<int>& nums) {
        int x = 0;
        for( int i = 0; i < nums.size(); i++){
            int count = 0;
            int rem = 0;
            while( nums[i] > 0){
                rem = nums[i] % 10;
                count++;
                nums[i] = nums[i] / 10;
            }
            if(count % 2 == 0){
                x++;
            }
        }
        return x;
    }
};
