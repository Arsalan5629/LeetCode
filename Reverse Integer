class Solution {
public:
    int reverse(int x) {
        long long ans = 0;
        int rem = 0;
        bool y = false;
        long long num = x;

        if (num < 0) {
            y = true;
            num = -num;
        }

        while (num > 0) {
            rem = num % 10;
            ans = ans * 10 + rem;
            num = num / 10;
        }

        if (y) {
            ans = -ans;
        }

        if (ans > INT_MAX || ans < INT_MIN) {
            return 0;
        }

        return (int)ans;
    }
};
